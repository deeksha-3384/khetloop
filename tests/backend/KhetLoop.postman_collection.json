    {
      "name": "1 Submit report (pick an image file in Body; saves reportId)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/reports",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "reports"
          ]
        },
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "farm_id",
              "value": "{{farmId}}",
              "type": "text"
            },
            {
              "key": "image",
              "type": "file",
              "src": []
            },
            {
              "key": "voice_text",
              "value": "it is spreading fast",
              "type": "text"
            },
            {
              "key": "language",
              "value": "en",
              "type": "text",
              "disabled": true
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 201\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"envelope has ok\", function () { pm.expect(pm.response.json()).to.have.property(\"ok\"); });",
              "pm.collectionVariables.set(\"reportId\", pm.response.json().data.id);"
            ]
          }
        }
      ]
    },
