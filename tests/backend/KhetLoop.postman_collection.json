{
  "info": {
    "name": "KhetLoop API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "expertKey",
      "value": "demo-expert-key"
    },
    {
      "key": "farmId",
      "value": ""
    },
    {
      "key": "reportId",
      "value": ""
    },
    {
      "key": "clusterId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "11 Health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"envelope has ok\", function () { pm.expect(pm.response.json()).to.have.property(\"ok\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "3 List farms (saves farmId)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/farms",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "farms"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"envelope has ok\", function () { pm.expect(pm.response.json()).to.have.property(\"ok\"); });",
              "var farms = pm.response.json().data.farms; if (farms && farms.length) { pm.collectionVariables.set(\"farmId\", farms[0].id); }"
            ]
          }
        }
      ]
    },
